+/**
+ * AI mayor patch: screenshot of width x height pixels centred on tile (x, y) at the given zoom level.
+ * Runs on the main thread like MakeScreenshot; the file appears shortly after this returns.
+ */
+void MakeScreenshotAt(uint tile_x, uint tile_y, uint32_t width, uint32_t height, ZoomLevel zoom, const std::string &name)
+{
+	VideoDriver::GetInstance()->QueueOnMainThread([=] {
+		int px = tile_x * TILE_SIZE + TILE_SIZE / 2, py = tile_y * TILE_SIZE + TILE_SIZE / 2;
+		_shot_center = RemapCoords2(px, py);
+		_shot_zoom = zoom;
+		_shot_override = true;
+		RealMakeScreenshot(SC_DEFAULTZOOM, name, width, height);
+		_shot_override = false;
+	});
+}
