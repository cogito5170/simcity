+/* AI mayor patch: 'shotat <x> <y> <width> <height> <zoom 0-5> <name>' saves a screenshot centred on tile (x, y).
+ * Works on dedicated servers, whose main viewport never moves. */
+static bool ConShotAt(std::span<std::string_view> argv)
+{
+	if (argv.size() != 7) {
+		IConsolePrint(CC_HELP, "Usage: 'shotat <x> <y> <width> <height> <zoom 0-5> <name>'.");
+		return true;
+	}
+	auto x = ParseInteger(argv[1]), y = ParseInteger(argv[2]), w = ParseInteger(argv[3]), h = ParseInteger(argv[4]), z = ParseInteger(argv[5]);
+	if (!x || !y || !w || !h || !z || *x >= Map::SizeX() || *y >= Map::SizeY() || *w == 0 || *h == 0 || *w > 4096 || *h > 4096 || *z > 5) {
+		IConsolePrint(CC_ERROR, "shotat: bad arguments.");
+		return true;
+	}
+	MakeScreenshotAt(*x, *y, *w, *h, static_cast<ZoomLevel>(*z), std::string(argv[6]));
+	return true;
+}
